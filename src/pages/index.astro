---
import Base from "@layouts/Base.astro";
import "@styles/cartela.css";
import Nav from "../cartela/Nav.astro";
import Hero from "../cartela/Hero.astro";
import ParaQuem from "../cartela/ParaQuem.astro";
import Tour from "../cartela/Tour.astro";
import ConversaIA from "../cartela/ConversaIA.astro";
import Rapido from "../cartela/Rapido.astro";
import Ticker from "../cartela/Ticker.astro";
import Junto from "../cartela/Junto.astro";
import Preco from "../cartela/Preco.astro";
import Duvidas from "../cartela/Duvidas.astro";
import Fim from "../cartela/Fim.astro";
import Rodape from "../cartela/Rodape.astro";
import { FAQS } from "@data/content";
---
<Base
  title="Agenda com IA no WhatsApp para salão, barbearia e estética"
  description="A IA do Skedoole conversa com suas clientes no WhatsApp, marca, lembra e remarca sozinha. Para barbearia, salão, manicure, lash, sobrancelha, spa dos pés e podologia. 14 dias grátis, sem cartão."
  bodyClass="cartela"
  canonical="/"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#f3f2ef" />
  </Fragment>
  <Nav />
  <main id="main">
    <Hero />
    <Ticker />
    <Tour />
    <ConversaIA />
    <Rapido />
    <ParaQuem />
    <Junto />
    <Preco />
    <Duvidas />
    <Fim />
  </main>
  <Rodape />
</Base>

<script>
  import "../scripts/revela";
</script>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQS.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })}
/>
