---
import Icon from "@components/Icon.astro";
import { SITE } from "@config/site";

const app = `${SITE.appUrl}/criar-conta`;
const wpp = SITE.whatsapp;
---
<div
  id="sticky-cta"
  class="sticky-cta"
  data-visible="false"
  role="region"
  aria-label="Chamada para ação"
>
  <div class="sticky-cta-inner">
    <a
      href={app}
      class="btn btn-primary sticky-cta-main"
      data-cta="sticky-cta-primary"
    >
      Começar grátis
      <Icon name="arrow-right" size={16} />
    </a>
    <a
      href={wpp}
      class="sticky-cta-wpp"
      target="_blank" rel="noopener"
      aria-label="Falar no WhatsApp"
      data-cta="sticky-cta-whatsapp"
    >
      <Icon name="whatsapp" size={18} />
    </a>
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 55;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in oklab, var(--cor-fundo) 88%, transparent) 45%,
      var(--cor-fundo) 100%
    );
    opacity: 0;
    visibility: hidden;
    transform: translateY(100%);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }
  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
  .sticky-cta[data-visible="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }
  .sticky-cta-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 480px;
    margin-inline: auto;
  }
  .sticky-cta-main {
    flex: 1;
    justify-content: center;
  }
  .sticky-cta-wpp {
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--cor-whatsapp);
    color: #fff;
    box-shadow: var(--sombra-card);
  }
  .sticky-cta-wpp:hover {
    opacity: 0.92;
  }
</style>

<script>
  const setup = () => {
    const bar = document.getElementById("sticky-cta");
    const hero = document.getElementById("hero");
    const footer = document.querySelector<HTMLElement>(".site-footer");
    if (!bar || !hero) return;

    let footerVisible = false;

    const update = () => {
      const pastHero = hero.getBoundingClientRect().bottom < 0;
      bar.dataset.visible = String(pastHero && !footerVisible);
    };

    if ("IntersectionObserver" in window && footer) {
      const io = new IntersectionObserver(
        (entries) => {
          footerVisible = entries[0].isIntersecting;
          update();
        },
        { threshold: 0 }
      );
      io.observe(footer);
    }

    window.addEventListener("scroll", update, { passive: true });
    update();
  };
  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
