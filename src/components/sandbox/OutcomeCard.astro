---
import Icon from "@components/Icon.astro";
import { SITE } from "@config/site";
import { SEGMENT } from "@data/sandbox";
import { lugarVazio } from "@data/segments";

const app = `${SITE.appUrl}/criar-conta`;
const modoFila = SEGMENT.fillMode === "queue";
---
<div class="sb-outcome" data-outcome hidden>
  <span class="sb-outcome__icon" aria-hidden="true">
    <Icon name="check-circle" size={24} />
  </span>

  <div class="sb-outcome__body">
    <p class="sb-outcome__kicker" data-outcome-kicker>Simulação concluída</p>
    <h3 data-outcome-title>
      {modoFila ? `Um cancelamento. Zero ${lugarVazio(SEGMENT)}.` : "Um cancelamento. Zero horário perdido."}
    </h3>
    <p data-outcome-text></p>
    <div class="sb-outcome__chips" data-outcome-chips>
      <span data-outcome-chip="recovered"></span>
      <span data-outcome-chip="filled">1 vaga preenchida</span>
      <span data-outcome-chip="empty"></span>
    </div>
  </div>

  <div class="sb-outcome__actions">
    <a href={app} class="btn btn-primary text-sm" data-cta="sandbox-outcome">
      Quero isso {SEGMENT.ctaPlace}
      <Icon name="arrow-right" size={15} />
    </a>
    <button
      type="button"
      class="btn btn-ghost text-sm"
      data-action="chapter"
      data-value="2"
      data-outcome-alt
    >
      Ver o lembrete de novo
    </button>
  </div>
</div>
