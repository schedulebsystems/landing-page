---
import { Image } from "astro:assets";
import { SITE } from "@config/site";
import poster from "../assets/3d/agenda-hero.png";

const criarConta = `${SITE.appUrl}/criar-conta`;
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="c-wrap hero-grid">
    <div class="hero-texto">
      <h1 id="hero-titulo" class="hero-titulo">Enquanto você atende, a IA marca a próxima.</h1>
      <p class="c-lead hero-lead">
        Agenda, clientes, equipe e caixa num lugar só. E uma IA no WhatsApp que acha o horário,
        marca, lembra na véspera e remarca enquanto você atende. De dia, de madrugada e no domingo.
      </p>
      <div class="hero-acoes">
        <a class="c-btn c-btn-laranja" href={criarConta} data-cta="hero-criar-conta">Criar conta grátis</a>
        <a class="c-link" href="#preco">Ver quanto custa</a>
      </div>
      <p class="c-fino hero-fino">14 dias com a IA ligada. Não pede cartão.</p>
    </div>

    <div class="hero-visual">
    <div class="hero-palco" data-agenda>
      <Image
        src={poster}
        alt="Agenda da semana, de terça a sábado, com vários horários já marcados em peças coloridas"
        widths={[560, 800, 1120, 1600]}
        sizes="(min-width: 960px) 52vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-poster"
      />
    </div>
      <div class="hero-conversa" data-conversa aria-live="polite">
        <div class="notif notif-cliente" data-msg-cliente>
          <span class="notif-av" data-av aria-hidden="true">A</span>
          <div class="notif-corpo">
            <p class="notif-topo"><strong data-nome>Ana</strong><time data-hora>agora</time></p>
            <p class="notif-txt" data-txt>Oi! Tem horário pra pé e mão terça às 9h?</p>
          </div>
        </div>
        <div class="notif-digitando" data-digitando hidden aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="notif notif-ia" data-msg-ia>
          <div class="notif-corpo">
            <p class="notif-topo"><strong>Secretária IA</strong><time data-hora>agora</time></p>
            <p class="notif-txt" data-txt>Marquei terça às 9h, Ana! Te lembro na véspera.</p>
          </div>
          <span class="notif-checks" aria-label="lida">✓✓</span>
        </div>
      </div>
    </div>
  </div>
  <div class="c-wrap hero-rodape">
    <p class="c-fino" data-contador>Cada peça colorida é um horário marcado. Toque num vazio para marcar.</p>
    <button type="button" class="hero-tocar" data-proximo hidden>
      Marcar o próximo horário livre
    </button>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }
  .hero-titulo {
    font-size: var(--t-display);
    max-width: 11ch;
    font-weight: 780;
  }
  .hero-lead {
    margin-top: 1.75rem;
  }
  .hero-acoes {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .hero-fino {
    margin-top: 1rem;
  }

  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
  }
  .hero-palco {
    position: relative;
    aspect-ratio: 1;
    margin-inline: calc(-1 * var(--gutter));
  }
  /* brilho de estúdio atrás da bandeja (lavanda + nude), não depende de WebGL */
  .hero-palco::before {
    content: "";
    position: absolute;
    inset: 8% 4% 10%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 38% 42%, rgb(255 180 143 / 0.42), transparent),
      radial-gradient(closest-side at 70% 64%, rgb(255 211 184 / 0.38), transparent);
    filter: blur(28px);
    pointer-events: none;
  }
  .hero-poster,
  .hero-palco :global(.c-agenda-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-poster {
    object-fit: contain;
    transition: opacity 0.5s ease;
  }
  .hero-palco :global(.c-agenda-canvas) {
    opacity: 0;
    transition: opacity 0.5s ease;
    touch-action: pan-y;
  }
  .hero-palco.is-vivo :global(.c-agenda-canvas) {
    opacity: 1;
  }
  .hero-palco.is-vivo .hero-poster {
    opacity: 0;
  }

  .hero-conversa {
    position: relative;
    z-index: 1;
    margin: 0 var(--gutter) -24%;
    min-height: 9.5rem;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    max-width: min(21rem, 86%);
    pointer-events: none;
  }
  .notif {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.7rem 0.85rem 0.75rem;
    border-radius: var(--raio-xl);
    font-size: 0.93rem;
    line-height: 1.35;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.6) inset, 0 18px 40px -22px rgb(19 19 22 / 0.6), 0 2px 6px -2px rgb(19 19 22 / 0.12);
    animation: notif-entra 0.42s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
  }
  .notif[hidden] {
    display: none;
  }
  .notif-cliente {
    justify-self: start;
    background: rgb(250 250 248 / 0.86);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    color: var(--tinta);
    border: 1px solid rgb(255 255 255 / 0.7);
  }
  .notif-ia {
    justify-self: end;
    position: relative;
    background: var(--tinta);
    color: var(--louca);
    border-bottom-right-radius: 6px;
    padding-right: 2.2rem;
  }
  .notif-av {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--nude);
    color: var(--tinta);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .notif-corpo {
    min-width: 0;
  }
  .notif-topo {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.1rem;
    font-size: 0.8rem;
  }
  .notif-topo strong {
    font-weight: 700;
  }
  .notif-topo time {
    color: var(--tinta-3);
    font-size: 0.75rem;
  }
  .notif-ia .notif-topo strong {
    color: var(--lavanda);
  }
  .notif-ia .notif-topo time {
    color: rgb(250 250 248 / 0.55);
  }
  .notif-txt {
    margin: 0;
  }
  .notif-checks {
    position: absolute;
    right: 0.75rem;
    bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: -0.2em;
    color: #7fd3ff;
  }
  .notif-digitando {
    justify-self: end;
    display: flex;
    gap: 4px;
    padding: 0.75rem 0.85rem;
    border-radius: var(--raio-xl);
    border-bottom-right-radius: 6px;
    background: var(--tinta);
    animation: notif-entra 0.3s ease both;
  }
  .notif-digitando[hidden] {
    display: none;
  }
  .notif-digitando span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lavanda);
    animation: notif-ponto 0.9s infinite ease-in-out;
  }
  .notif-digitando span:nth-child(2) {
    animation-delay: 0.12s;
  }
  .notif-digitando span:nth-child(3) {
    animation-delay: 0.24s;
  }
  @keyframes notif-ponto {
    0%,
    80%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    40% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }
  @keyframes notif-entra {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.94);
      filter: blur(3px);
    }
  }

  .hero-rodape {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    margin-top: 0.5rem;
  }
  .hero-tocar {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: var(--t-mini);
    color: var(--tinta-2);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .hero-tocar[hidden] {
    display: none;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
      gap: 1rem;
    }
    .hero-visual {
      display: block;
    }
    .hero-palco {
      margin-inline: 0 calc(-1 * var(--gutter) - 4vw);
      margin-block: -3rem -2rem;
    }
    .hero-conversa {
      position: absolute;
      margin: 0;
      min-height: 0;
      left: -3%;
      top: -1%;
    }
    .hero-rodape {
      justify-content: flex-end;
      margin-top: -1rem;
    }
  }
</style>

<script>
  const DIA_LONGO: Record<string, string> = { ter: "terça", qua: "quarta", qui: "quinta", sex: "sexta", "sáb": "sábado" };
  const COMO_PEDE: Record<string, string> = {
    "Pé e mão": "pé e mão", Corte: "corte", "Lash lift": "lash lift", Sobrancelha: "design de sobrancelha",
    "Spa dos pés": "spa dos pés", Escova: "escova", Barba: "barba", Alongamento: "alongamento de unha",
    Podologia: "podologia", "Esmaltação": "esmaltação em gel",
  };
  const PEDIDOS = [
    (s: string, d: string, h: number) => `Oi! Tem horário pra ${s} ${d} às ${h}h?`,
    (s: string, d: string, h: number) => `Consegue ${s} ${d}, ${h}h?`,
    (s: string, d: string, h: number) => `Queria marcar ${s} ${d}. Tem às ${h}h?`,
    (s: string, d: string, h: number) => `Boa noite! ${s[0].toUpperCase() + s.slice(1)} ${d} às ${h}h, tem vaga?`,
  ];

  const palco = document.querySelector<HTMLElement>("[data-agenda]");
  const msgCliente = document.querySelector<HTMLElement>("[data-msg-cliente]");
  const msgIa = document.querySelector<HTMLElement>("[data-msg-ia]");
  const digitando = document.querySelector<HTMLElement>("[data-digitando]");
  const contador = document.querySelector<HTMLElement>("[data-contador]");
  const proximo = document.querySelector<HTMLButtonElement>("[data-proximo]");
  const conversa = document.querySelector<HTMLElement>("[data-conversa]");

  const temWebGL = () => {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  };
  const economia = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const relogio = () => new Date().toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
  const reanimar = (el: HTMLElement) => {
    el.style.animation = "none";
    void el.offsetWidth;
    el.style.animation = "";
  };

  if (palco && msgCliente && msgIa && digitando && contador && proximo && conversa && temWebGL() && !economia) {
    const reduzido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const campo = (el: HTMLElement, nome: string) => el.querySelector<HTMLElement>(`[data-${nome}]`)!;
    let marcados = 0;
    let n = 0;
    let timers: number[] = [];

    const iniciar = async () => {
      const { montarAgenda } = await import("../scripts/agenda3d");
      const cena = await montarAgenda({
        container: palco,
        reduzido,
        onPronto: () => {
          palco.classList.add("is-vivo");
          proximo.hidden = false;
        },
        onMarcar: ({ dia, hora, servico, cliente, auto, livres }) => {
          marcados++;
          const d = DIA_LONGO[dia] ?? dia;
          const s = COMO_PEDE[servico] ?? servico.toLowerCase();
          // anúncio só para ação da pessoa; o autoplay não fala com leitor de tela
          conversa.setAttribute("aria-live", auto ? "off" : "polite");
          timers.forEach(clearTimeout);
          timers = [];
          campo(msgCliente, "av").textContent = cliente[0];
          campo(msgCliente, "nome").textContent = cliente;
          campo(msgCliente, "txt").textContent = PEDIDOS[n++ % PEDIDOS.length](s, d, hora);
          msgCliente.querySelectorAll<HTMLElement>("[data-hora]").forEach((t) => (t.textContent = relogio()));
          msgCliente.hidden = false;
          msgIa.hidden = true;
          digitando.hidden = true;
          reanimar(msgCliente);
          const responder = () => {
            digitando.hidden = true;
            campo(msgIa, "txt").textContent = `Marquei ${s} ${d} às ${hora}h, ${cliente}! Te lembro na véspera.`;
            campo(msgIa, "hora").textContent = relogio();
            msgIa.hidden = false;
            reanimar(msgIa);
          };
          contador.textContent =
            livres === 0
              ? "Semana cheia. É isso que a gente quer pra você."
              : `${marcados} ${marcados === 1 ? "horário marcado" : "horários marcados"} desde que você chegou.`;
          if (reduzido) return responder();
          timers.push(window.setTimeout(() => {
            digitando.hidden = false;
            reanimar(digitando);
          }, 250));
          timers.push(window.setTimeout(responder, 850));
        },
      });
      proximo.addEventListener("click", () => cena.marcarProximo());
    };

    const quandoOcioso = (fn: () => void) =>
      "requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 800);
    if (document.readyState === "complete") quandoOcioso(iniciar);
    else window.addEventListener("load", () => quandoOcioso(iniciar), { once: true });
  }
</script>
