---
/**
 * Faixa logo abaixo do hero: o que o Skedoole faz sozinho num dia comum, passando rápido.
 * Ilustrativa (nomes de exemplo); decorativa para leitor de tela, com o resumo num texto oculto.
 */
const eventos = [
  ["IA", "marcou pé e mão pra Ana, sáb 09:30"],
  ["Lembrete", "enviado pra 14 clientes de amanhã"],
  ["IA", "remarcou o corte do Rafa pra 16h"],
  ["Vaga", "das 15h voltou pra agenda"],
  ["Caixa", "Pix de R$ 120,00 recebido"],
  ["IA", "respondeu o preço do lash lift às 23h40"],
  ["Comissão", "da Bruna atualizada"],
  ["Link", "Juliana agendou sobrancelha pelo Instagram"],
];
---
<div class="tk" aria-label="Exemplos do que o Skedoole faz sozinho: marca, lembra, remarca, devolve vagas e separa comissões.">
  <div class="tk-faixa" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="tk-lista">
        {eventos.map(([tag, txt]) => (
          <li>
            <span class={`tk-tag ${tag === "IA" ? "tk-ia" : ""}`}>{tag}</span>
            {txt}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .tk {
    position: relative;
    overflow: hidden;
    background: var(--tinta);
    color: var(--louca);
    padding-block: 0.95rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .tk-faixa {
    display: flex;
    width: max-content;
    animation: tk-anda 42s linear infinite;
  }
  .tk:hover .tk-faixa {
    animation-play-state: paused;
  }
  .tk-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2.75rem;
    padding-right: 2.75rem;
  }
  .tk-lista li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    font-size: 0.95rem;
    color: rgb(250 250 248 / 0.85);
  }
  .tk-tag {
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: rgb(250 250 248 / 0.12);
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--louca);
  }
  /* verde do WhatsApp (IDENTIDADE_VISUAL: #25D366 no escuro) */
  .tk-ia {
    background: #1da851;
    color: #fff;
  }
  @keyframes tk-anda {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-faixa {
      animation: none;
      overflow-x: auto;
    }
  }
</style>
