---
import { Image } from "astro:assets";
import pente from "../assets/3d/pente.png";
import escova from "../assets/3d/escova.png";
import esmalte from "../assets/3d/esmalte.png";
import pinca from "../assets/3d/pinca.png";
import toalhas from "../assets/3d/toalhas.png";
import fBarbearia from "../assets/fotos/barbearia.jpg";
import fSalao from "../assets/fotos/salao.jpg";
import fManicure from "../assets/fotos/manicure.jpg";
import fLash from "../assets/fotos/lash.jpg";
import fPes from "../assets/fotos/pes.jpg";

const itens = [
  { foto: fBarbearia, fotoAlt: "Barbeiro fazendo corte em cliente", pos: "40% 30%", img: pente, alt: "Pente de barbeiro", nome: "Barbearia", texto: "Corte e barba em sequência, com encaixe no fim da tarde." },
  { foto: fSalao, fotoAlt: "Cabeleireira atendendo cliente no salão", pos: "62% 40%", img: escova, alt: "Escova redonda", nome: "Salão", texto: "Escova, coloração e química, cada uma com o tempo de cada profissional." },
  { foto: fManicure, fotoAlt: "Manicure lixando as unhas de uma cliente", pos: "55% 50%", img: esmalte, alt: "Vidro de esmalte", nome: "Manicure e nail designer", texto: "Pé e mão, alongamento e manutenção na agenda de cada manicure." },
  { foto: fLash, fotoAlt: "Profissional fazendo extensão de cílios", pos: "55% 50%", img: pinca, alt: "Pinça de sobrancelha", nome: "Lash e sobrancelha", texto: "Lash lift, extensão de cílios e design sem buraco entre uma e outra." },
  { foto: fPes, fotoAlt: "Atendimento de spa dos pés", pos: "30% 50%", img: toalhas, alt: "Toalhas de spa enroladas", nome: "Spa dos pés e podologia", texto: "Sessões marcadas e a cliente lembrada na véspera, sem você ligar." },
];
---
<section id="pra-quem" class="c-sec pq c-mesh" style="--m1x:15%;--m1y:20%;--m2x:90%;--m2y:80%" aria-labelledby="pq-titulo">
  <div class="c-wrap">
    <div class="pq-topo">
      <h2 id="pq-titulo" class="c-h2" data-revela>Pra quem vive de horário marcado.</h2>
      <p class="c-lead" data-sobe>
        A agenda muda de cara para cada negócio: os serviços, o tempo de cada um e quem faz o quê.
        A IA responde com os seus serviços, os seus preços e os seus horários.
      </p>
    </div>
    <ul class="pq-lista">
      {itens.map((i, n) => (
        <li class="pq-item" data-sobe style={`--d:${n}`}>
          <div class="pq-midia">
            <Image src={i.foto} alt={i.fotoAlt} widths={[320, 480, 640, 800]} sizes="(min-width: 960px) 19vw, 46vw" class="pq-foto" style={`object-position:${i.pos}`} loading="lazy" />
            <div class="pq-obj c-parallax" style={`--vel:${[0.6, 1.3, 0.9, 1.6, 1.1][n]};--gira:${n % 2 ? 1 : -1}`}>
              <Image src={i.img} alt="" widths={[160, 240]} sizes="120px" class="pq-img" />
            </div>
          </div>
          <h3 class="pq-nome">{i.nome}</h3>
          <p class="pq-texto">{i.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pq {
    background: var(--louca);
  }
  .pq-topo {
    display: grid;
    gap: 1.5rem;
  }
  .pq-lista {
    list-style: none;
    margin: clamp(3rem, 2rem + 4vw, 5.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
  }
  .pq-midia {
    position: relative;
  }
  .pq-foto {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--raio-card);
    box-shadow: var(--sombra-card);
    filter: saturate(0.92) contrast(1.02);
  }
  /* objeto 3D do segmento saindo do canto da foto */
  .pq-obj {
    position: absolute;
    right: -0.75rem;
    bottom: -1.75rem;
    width: 46%;
    max-width: 8rem;
    pointer-events: none;
    filter: drop-shadow(0 14px 18px rgb(19 19 22 / 0.22));
  }
  .pq-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .pq-nome {
    font-size: var(--t-h3);
    margin-top: 1.5rem;
  }
  .pq-texto {
    margin-top: 0.5rem;
    color: var(--tinta-2);
    font-size: var(--t-mini);
    max-width: 24ch;
  }
  .pq-item:last-child {
    grid-column: 1 / -1;
    max-width: 50%;
  }

  @media (min-width: 960px) {
    .pq-topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
    .pq-lista {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
    /* fileira desencontrada: cada objeto numa altura */
    .pq-item:nth-child(2) { margin-top: 5rem; }
    .pq-item:nth-child(3) { margin-top: 1.5rem; }
    .pq-item:nth-child(4) { margin-top: 7rem; }
    .pq-item:nth-child(5) { margin-top: 2.5rem; }
    .pq-item:last-child {
      grid-column: auto;
      max-width: none;
    }
  }
</style>
