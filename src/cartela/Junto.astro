---
/**
 * "Vem junto": tudo o que o salão precisa, em pequeno. Cada card tem uma etiqueta da área
 * (WhatsApp, Agenda, Vitrine...) e uma mini-tela no visual do app, que mexe sozinha quando
 * aparece (CSS puro, pausa fora da tela e com movimento reduzido). Fecha com o card de valor.
 * Nomes, horários e valores são de exemplo, como no tour.
 */
import { Image } from "astro:assets";
import fManicure from "../assets/fotos/manicure.jpg";
import fLash from "../assets/fotos/lash.jpg";
import fSalao from "../assets/fotos/salao.jpg";
import fPes from "../assets/fotos/pes.jpg";
import fBarbearia from "../assets/fotos/barbearia.jpg";
import fDona from "../assets/fotos/dona-celular.jpg";

// ícones de traço (24x24), no estilo dos ícones do app
const ICONES: Record<string, string> = {
  wpp: "M4 20l1.3-3.9A8 8 0 1 1 8 18.7L4 20z",
  agenda: "M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z",
  link: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1",
  caixa: "M3 7h18v12H3zM3 11h18M7 15h3",
  clientes: "M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M9.5 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM21 19v-1a4 4 0 0 0-3-3.9M15.5 3.2a3.5 3.5 0 0 1 0 6.6",
  clube: "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z",
  equipe: "M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 18h2",
};

type Atend = { h: string; cli: string; sv: string; st: "pago" | "agora" | "conf" | "ia" | "livre"; dur: number };
const profissionais: { nome: string; papel: string; foto: ImageMetadata; pos: string; itens: Atend[] }[] = [
  {
    nome: "Rafa", papel: "Barbeiro", foto: fBarbearia, pos: "38% 14%",
    itens: [
      { h: "09:00", cli: "Diego", sv: "Corte + barba", st: "pago", dur: 2 },
      { h: "10:30", cli: "Léo", sv: "Corte", st: "agora", dur: 1 },
      { h: "14:00", cli: "Caio", sv: "Barba", st: "conf", dur: 1 },
    ],
  },
  {
    nome: "Lívia", papel: "Cabeleireira", foto: fSalao, pos: "68% 22%",
    itens: [
      { h: "09:30", cli: "Ana", sv: "Escova", st: "pago", dur: 1 },
      { h: "11:00", cli: "Bia", sv: "Coloração", st: "conf", dur: 2 },
      { h: "15:00", cli: "Malu", sv: "Corte", st: "ia", dur: 1 },
    ],
  },
  {
    nome: "Camila", papel: "Lash designer", foto: fDona, pos: "42% 34%",
    itens: [
      { h: "10:00", cli: "Júlia", sv: "Lash lift", st: "agora", dur: 2 },
      { h: "13:00", cli: "Nina", sv: "Sobrancelha", st: "conf", dur: 1 },
      { h: "16:00", cli: "", sv: "", st: "livre", dur: 1 },
    ],
  },
];
const ROTULO = { pago: "Pago", agora: "Em atendimento", conf: "Confirmado", ia: "Marcado pela IA", livre: "Livre" };

const servicos = [
  { foto: fLash, nome: "Lash lift", tempo: "1h", preco: "R$ 120" },
  { foto: fManicure, nome: "Pé e mão", tempo: "1h30", preco: "R$ 55" },
  { foto: fPes, nome: "Spa dos pés", tempo: "50min", preco: "R$ 80" },
];

const inclusos = ["IA no WhatsApp", "Agenda da equipe", "Lembretes", "Link de agendamento", "Caixa e comissão", "Clube de assinatura", "Quem chamar hoje", "App da equipe"];
---
<section class="c-sec junto c-pontos" aria-labelledby="junto-titulo">
  <div class="c-wrap">
    <div class="junto-topo">
      <h2 id="junto-titulo" class="c-h2" data-revela>O resto vem junto, no mesmo preço.</h2>
      <p class="c-lead" data-sobe>
        A IA no WhatsApp não é extra pago à parte. Ela e tudo isto estão em todo plano: oito
        ferramentas que o salão usaria separadas, numa assinatura só.
      </p>
    </div>

    <ul class="bento">
      <!-- AGENDA -->
      <li class="b b-agenda" data-sobe style="--d:0">
        <span class="b-tag" style="--tom:var(--laranja)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.agenda} /></svg>Agenda</span>
        <h3>A agenda de cada profissional</h3>
        <p>Cada uma com os próprios horários, folgas e o tempo de cada serviço. Você vê todas numa tela.</p>
        <div class="b-mini b-dia">
          <div class="b-dia-topo">
            <b>Hoje, qua 25</b>
            <span class="b-dia-kpi"><span>8 atendimentos</span><span class="b-dia-kpi-v">R$ 1.240 previstos</span></span>
          </div>
          <div class="b-dia-cols">
            {profissionais.map((p, ip) => (
              <div class="b-prof">
                <div class="b-prof-quem">
                  <Image src={p.foto} alt="" widths={[96]} sizes="40px" class="b-prof-foto" style={`object-position:${p.pos}`} loading="lazy" />
                  <span><b>{p.nome}</b><small>{p.papel}</small></span>
                </div>
                <div class="b-prof-lista">
                  {p.itens.map((a, ia) => (
                    <div class={`b-at b-at--${a.st}`} style={`--k:${ip * 3 + ia};--dur:${a.dur}`}>
                      {a.st === "livre" ? (
                        <span class="b-at-livre">{a.h} · horário livre</span>
                      ) : (
                        <>
                          <span class="b-at-h">{a.h}</span>
                          <b class="b-at-cli">{a.cli}</b>
                          <span class="b-at-sv">{a.sv}</span>
                          <span class="b-at-st">{ROTULO[a.st]}</span>
                        </>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </li>

      <!-- VITRINE -->
      <li class="b b-link" data-sobe style="--d:1">
        <span class="b-tag" style="--tom:#2563eb"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.link} /></svg>Vitrine</span>
        <h3>Seu link de agendamento</h3>
        <p>Fotos, serviços com preço e os horários livres. A cliente marca sozinha pela bio do Instagram.</p>
        <div class="b-mini b-vitrine">
          <div class="b-vt-capa">
            <Image src={fSalao} alt="" widths={[480, 720]} sizes="(min-width: 1080px) 22vw, 90vw" loading="lazy" />
            <span class="b-vt-url">studiocamila.skedoole.com.br</span>
          </div>
          <div class="b-vt-cab">
            <span class="b-vt-logo">SC</span>
            <span><b>Studio Camila</b><small><span class="b-on"></span>Aberto hoje até 19h</small></span>
          </div>
          <ul class="b-vt-servicos">
            {servicos.map((s, i) => (
              <li class={i === 0 ? "is-sel" : ""}>
                <Image src={s.foto} alt="" widths={[96]} sizes="40px" loading="lazy" />
                <span><b>{s.nome}</b><small>{s.tempo}</small></span>
                <b>{s.preco}</b>
              </li>
            ))}
          </ul>
          <p class="b-vt-rot">Horários de hoje</p>
          <div class="b-vt-horas">
            <span>14:00</span><span class="is-sel">15:30</span><span>17:00</span><span>18:00</span>
          </div>
          <span class="b-agendar">Agendar lash lift às 15:30</span>
          <p class="b-vt-rot">Trabalhos</p>
          <div class="b-vt-galeria" aria-hidden="true">
            {[fLash, fManicure, fPes].map((f) => <Image src={f} alt="" widths={[200]} sizes="90px" loading="lazy" />)}
          </div>
          <div class="b-vt-aval">
            <span class="b-vt-estrelas" aria-hidden="true">★★★★★</span>
            <p>“Marquei às 23h pelo link e já recebi a confirmação. Amei!”</p>
            <small>Cliente do salão · exemplo</small>
          </div>
        </div>
      </li>

      <!-- LEMBRETE -->
      <li class="b b-lembrete" data-sobe style="--d:2">
        <span class="b-tag" style="--tom:#1da851"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.wpp} /></svg>WhatsApp</span>
        <h3>Lembrete na véspera</h3>
        <p>A cliente recebe o link do horário pra confirmar ou remarcar, sem você mandar nada.</p>
        <div class="b-mini b-conversa">
          <div class="b-wpp">
            <p>Oi, Ana! Amanhã às 14h tem <b>pé e mão</b> com a Bruna. Confirma ou remarca por aqui:</p>
            <span class="b-wpp-link">app.skedoole.com.br/h/…</span>
            <time>18:00 ✓✓</time>
          </div>
          <div class="b-wpp b-wpp-cli"><p>Confirmado! 💅</p><time>18:03</time></div>
        </div>
      </li>

      <!-- VAGA -->
      <li class="b b-vaga" data-sobe style="--d:3">
        <span class="b-tag" style="--tom:var(--laranja)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.agenda} /></svg>Agenda</span>
        <h3>Cancelou, a vaga volta</h3>
        <p>O horário reabre na hora, no seu link e na IA.</p>
        <div class="b-mini">
          <div class="b-slot">
            <span class="b-hora">15h</span>
            <span class="b-estado">
              <span class="e1">Malu cancelou</span>
              <span class="e2">Horário livre</span>
              <span class="e3">Marcado pela IA ✓</span>
            </span>
          </div>
        </div>
      </li>

      <!-- CAIXA -->
      <li class="b b-caixa" data-sobe style="--d:0">
        <span class="b-tag" style="--tom:#1a9f55"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.caixa} /></svg>Financeiro</span>
        <h3>Caixa e comissão</h3>
        <p>Recebe em Pix ou cartão e a comissão de cada uma já sai separada.</p>
        <div class="b-mini">
          <p class="b-pix"><span><span class="b-ok">✓</span> Pix recebido</span><b>R$ 120,00</b></p>
          <div class="b-divide"><i class="d1"></i><i class="d2"></i></div>
          <p class="b-legenda"><span><i class="p1"></i>Lívia R$ 48,00</span><span><i class="p2"></i>Salão R$ 72,00</span></p>
        </div>
      </li>

      <!-- CHAMAR HOJE -->
      <li class="b b-chamar" data-sobe style="--d:1">
        <span class="b-tag" style="--tom:#7c3aed"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.clientes} /></svg>Clientes</span>
        <h3>Quem chamar hoje</h3>
        <p>Quem sumiu, faz aniversário ou está na hora da manutenção, pronta pra você mandar mensagem.</p>
        <div class="b-mini">
          {[
            ["Marina S.", "38 dias sem vir", "Sumida"],
            ["Juliana P.", "aniversário hoje 🎂", "Aniversário"],
            ["Fernanda L.", "manutenção do alongamento", "Retorno"],
          ].map(([n, m, t], i) => (
            <div class="b-linha" style={`--k:${i}`}>
              <span class="b-av">{n[0]}</span>
              <span class="b-quem"><b>{n}</b><small>{m}</small></span>
              <span class="b-motivo">{t}</span>
              <span class="b-chama">Chamar</span>
            </div>
          ))}
        </div>
      </li>

      <!-- CLUBE -->
      <li class="b b-clube" data-sobe style="--d:2">
        <span class="b-tag" style="--tom:#d97706"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.clube} /></svg>Clube</span>
        <h3>Clube de assinatura</h3>
        <p>A cliente paga por mês e você sabe quanto entra antes do mês começar.</p>
        <div class="b-mini b-cartao">
          <small>Clube Studio Camila</small>
          <strong>Mãos sempre feitas</strong>
          <span class="b-usos"><i class="u"></i><i class="u"></i><i></i><i></i></span>
          <small>2 de 4 usos no mês · R$ 149/mês</small>
        </div>
      </li>

      <!-- EQUIPE -->
      <li class="b b-equipe" data-sobe style="--d:0">
        <span class="b-tag" style="--tom:var(--tinta)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES.equipe} /></svg>Equipe</span>
        <h3>A equipe no celular</h3>
        <p>Cada uma vê a própria agenda e quanto já fez no mês, sem te perguntar.</p>
        <div class="b-mini b-meu">
          <Image src={fSalao} alt="" widths={[120]} sizes="56px" class="b-meu-foto" style="object-position:68% 22%" loading="lazy" />
          <p><small>Lívia, este mês</small><b data-conta="1860">R$ 1.860</b><small>em comissão · 42 atendimentos</small></p>
          <div class="b-semana" aria-hidden="true">
            {[40, 65, 50, 80, 95, 70].map((v, i) => <i style={`--v:${v};--k:${i}`} />)}
          </div>
        </div>
      </li>

      <!-- VALOR -->
      <li class="b b-valor" data-sobe style="--d:1">
        <p class="b-valor-rot">Tudo isso incluso</p>
        <p class="b-valor-preco"><small>a partir de</small> R$ 59,90<small>/mês</small></p>
        <ul class="b-valor-lista">
          {inclusos.map((t) => <li>{t}</li>)}
        </ul>
        <a class="b-valor-cta" href="#preco" data-cta="junto-ver-preco">Ver quanto fica pra sua equipe →</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .junto {
    background: var(--porcelana);
  }
  .junto-topo {
    display: grid;
    gap: 1.5rem;
  }
  .bento {
    list-style: none;
    margin: clamp(2.5rem, 2rem + 3vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .b {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.25rem;
    border-radius: var(--raio-card);
    background: #fff;
    box-shadow: 0 0 0 1px rgb(19 19 22 / 0.06), 0 18px 40px -30px rgb(19 19 22 / 0.5);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
  }
  .b:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px rgb(19 19 22 / 0.08), 0 28px 50px -30px rgb(19 19 22 / 0.6);
  }
  /* etiqueta da área: deixa claro o que é cada card */
  .b-tag {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem 0.25rem 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--tom) 10%, #fff);
    color: color-mix(in srgb, var(--tom) 80%, #131316);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .b-tag svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .b h3 {
    font-size: 1.35rem;
    margin-top: 0.75rem;
  }
  .b > p:not([class]) {
    margin-top: 0.375rem;
    color: var(--tinta-2);
    font-size: var(--t-mini);
    line-height: 1.5;
    max-width: 44ch;
  }
  .b-mini {
    position: relative;
    flex: 1;
    min-height: 8rem;
    margin-top: 1rem;
    display: grid;
    align-content: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--raio-xl);
    background: #f3f4f6;
    font-size: 0.875rem;
    line-height: 1.35;
    overflow: hidden;
  }
  /* animações só rodam com o card na tela */
  .b * {
    animation-play-state: paused !important;
  }
  .b.is-visto *,
  html:not(.js-rv) .b * {
    animation-play-state: running !important;
  }
  .b-av {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--nude);
    color: var(--tinta);
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .b-on {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.3rem;
    border-radius: 50%;
    background: #1da851;
  }

  /* ---------- agenda do dia (cards no padrão Meu Dia) */
  .b-dia {
    align-content: start;
    gap: 0.75rem;
    padding: 0.875rem;
  }
  .b-dia-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .b-dia-topo > b {
    font-size: 1rem;
  }
  .b-dia-kpi {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--tinta-2);
  }
  .b-dia-kpi-v {
    color: #1a7f4b;
    font-weight: 700;
  }
  .b-dia-cols {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(11.5rem, 1fr);
    gap: 0.625rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: -0.875rem;
    padding-inline: 0.875rem;
    scroll-snap-type: x mandatory;
  }
  .b-dia-cols::-webkit-scrollbar {
    display: none;
  }
  .b-prof {
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .b-prof-quem {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
  }
  .b-prof-foto {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--laranja);
  }
  .b-prof-quem span {
    display: grid;
    line-height: 1.2;
  }
  .b-prof-quem small {
    color: var(--tinta-2);
    font-size: 0.75rem;
  }
  .b-prof-lista {
    display: grid;
    gap: 0.375rem;
  }
  .b-at {
    --tone: #2563eb;
    --tone-bg: #eff6ff;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    align-items: baseline;
    min-height: calc(2.75rem + (var(--dur) - 1) * 1.6rem);
    padding: 0.5rem 0.625rem 0.5rem 0.875rem;
    border-radius: var(--raio-lg);
    background: #fff;
    box-shadow: inset 0 0 0 1px #e5e7eb;
    overflow: hidden;
    animation: b-at-entra 0.5s cubic-bezier(0.2, 1.1, 0.3, 1) both;
    animation-delay: calc(var(--k) * 90ms + 150ms);
  }
  .b-at::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--tone);
  }
  .b-at--pago { --tone: #1a9f55; --tone-bg: #e8f5ee; }
  .b-at--agora { --tone: var(--laranja); --tone-bg: rgb(255 90 36 / 0.1); background: rgb(255 90 36 / 0.06); }
  .b-at--ia { --tone: #1da851; --tone-bg: #e8f5ee; animation-delay: 2.2s; }
  .b-at-h {
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .b-at-cli {
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .b-at-sv {
    grid-column: 1 / -1;
    color: var(--tinta-2);
    font-size: 0.8125rem;
  }
  .b-at-st {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.25rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: var(--tone-bg);
    color: var(--tinta);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .b-at--agora .b-at-st {
    background: var(--laranja);
    color: #fff;
  }
  .b-at--ia .b-at-st {
    background: #1da851;
    color: #fff;
  }
  .b-at--livre {
    background: transparent;
    box-shadow: none;
    outline: 1.5px dashed rgb(19 19 22 / 0.22);
    outline-offset: -1.5px;
    align-items: center;
  }
  .b-at--livre::before {
    display: none;
  }
  .b-at-livre {
    grid-column: 1 / -1;
    color: var(--tinta-2);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  @keyframes b-at-entra {
    from { opacity: 0; transform: translateY(10px) scale(0.97); }
  }

  /* ---------- vitrine (página pública) */
  .b-vitrine {
    align-content: start;
    gap: 0.625rem;
    padding: 0 0 0.875rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px #e5e7eb;
  }
  .b-vt-capa {
    position: relative;
  }
  .b-vt-capa img {
    display: block;
    width: 100%;
    height: 7.5rem;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .b-vt-url {
    position: absolute;
    left: 50%;
    top: 0.625rem;
    transform: translateX(-50%);
    padding: 0.25rem 0.625rem;
