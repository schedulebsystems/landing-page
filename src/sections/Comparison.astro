---
import Icon from "@components/Icon.astro";
import Reveal from "@components/Reveal.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { COMPARISON } from "@data/content";
---
<section id="comparacao" class="py-16 md:py-24">
  <div class="container-tight">
    <SectionHeading eyebrow="Antes e depois" align="center" class="max-w-2xl">
      <Fragment slot="title">
        O mesmo dia de trabalho,<br />do caderno pra Skedoole.
      </Fragment>
      <Fragment slot="lede">
        Sem mudar nada no seu jeito de atender. Só muda o jeito de
        organizar — e o cliente sente a diferença no mesmo dia.
      </Fragment>
    </SectionHeading>

    <Reveal class="mt-12">
      <div
        class="cmp"
        role="table"
        aria-label="Comparação entre caderno e planilha e a Skedoole"
      >
        <div class="cmp-row cmp-head" role="row">
          <div class="cmp-cell cmp-label" role="columnheader">No dia a dia</div>
          <div class="cmp-cell cmp-bad" role="columnheader">
            Hoje, no caderno e na planilha
          </div>
          <div class="cmp-cell cmp-good" role="columnheader">
            <span class="cmp-chip">
              <Icon name="check" size={14} /> Com a Skedoole
            </span>
          </div>
        </div>
        {COMPARISON.map((row) => (
          <div class="cmp-row" role="row">
            <div class="cmp-cell cmp-label" role="cell">{row.label}</div>
            <div class="cmp-cell cmp-bad" role="cell">
              <Icon name="x" size={15} class="cmp-x" />
              <span>{row.manual}</span>
            </div>
            <div class="cmp-cell cmp-good" role="cell">
              <Icon name="check" size={15} class="cmp-check" />
              <span>{row.skedoole}</span>
            </div>
          </div>
        ))}
      </div>
    </Reveal>
  </div>
</section>

<style>
  .cmp {
    display: grid;
    gap: 1px;
    background: var(--cor-borda-geral);
    border: 1px solid var(--cor-borda-geral);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--sombra-card);
  }
  .cmp-row {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1.1fr;
    background: var(--cor-cards);
  }
  .cmp-cell {
    padding: 16px 18px;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .cmp-head {
    background: var(--cor-fundo-elevado);
  }
  .cmp-head .cmp-cell {
    display: flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cor-texto-primario);
  }
  .cmp-head .cmp-bad {
    color: var(--cor-subtitulos);
    font-weight: 500;
  }
  .cmp-good {
    background: color-mix(in oklab, var(--cor-primaria-soft) 35%, var(--cor-cards));
  }
  .cmp-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--cor-status-ok);
  }
  .cmp-label {
    font-weight: 600;
    color: var(--cor-texto-primario);
  }
  .cmp-bad,
  .cmp-good {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .cmp-bad {
    color: var(--cor-subtitulos);
  }
  .cmp-x {
    flex: 0 0 auto;
    margin-top: 3px;
    color: var(--cor-subtitulos);
  }
  .cmp-check {
    flex: 0 0 auto;
    margin-top: 3px;
    color: var(--cor-status-ok);
  }
  @media (max-width: 720px) {
    .cmp-row {
      grid-template-columns: 1fr;
    }
    .cmp-head .cmp-label {
      display: none;
    }
    .cmp-head .cmp-cell {
      padding-block: 12px;
    }
    .cmp-label {
      background: var(--cor-fundo-elevado);
      font-size: 0.85rem;
      padding-block: 12px;
    }
    .cmp-bad,
    .cmp-good {
      font-size: 0.85rem;
    }
  }
</style>
