---
import Icon from "@components/Icon.astro";
import Reveal from "@components/Reveal.astro";
import { SITE } from "@config/site";
import { STATS, CHAT_MSGS } from "@data/content";

const app = `${SITE.appUrl}/criar-conta`;
const wpp = SITE.whatsapp;
---
<section id="hero" class="relative overflow-hidden pt-24 md:pt-28 pb-16 md:pb-24">
  <div class="hero-bg" aria-hidden="true"></div>
  <canvas class="hero-mesh" aria-hidden="true"></canvas>

  <div class="container-tight relative z-10 grid gap-10 md:gap-12 lg:grid-cols-[1.05fr_0.95fr] items-center">
    <div class="hero-copy">
      <Reveal>
        <span class="eyebrow">Agenda digital + IA no WhatsApp</span>
      </Reveal>
      <Reveal delay="80">
        <h1 class="hero-title mt-4">
          Enquanto você atende,<br class="hero-br" /> a <span class="hero-hl font-black">IA agenda</span> por você.
        </h1>
      </Reveal>
      <Reveal delay="160">
        <p class="hero-lede mt-5">
          Seu cliente manda mensagem, a IA confere sua agenda de verdade e
          fecha o horário — sem te tirar do meio de um atendimento pra
          responder celular.
        </p>
      </Reveal>
      <Reveal delay="240">
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={app}
            class="btn btn-primary text-base"
            data-cta="hero-primary"
          >
            Começar grátis
            <Icon name="arrow-right" size={18} />
          </a>
          <a
            href={wpp}
            class="btn btn-ghost hover:bg-[var(--cor-whatsapp-bg)] hover:border-[var(--cor-whatsapp)] hover:text-[var(--cor-whatsapp)]"
            target="_blank"
            rel="noopener"
            data-cta="hero-whatsapp"
          >
            <Icon name="whatsapp" size={18} />
            Falar no WhatsApp
          </a>
        </div>
      </Reveal>
      <Reveal delay="320">
        <p class="hero-microcopy mt-4">
          14 dias grátis · não pede cartão · a IA atende já no teste
        </p>
      </Reveal>
    </div>

    <Reveal as="div" delay="200">
      <div class="hero-mockup-wrap">
        <div class="hero-mockup chat-mockup shadow-lg" aria-label="Exemplo de conversa com a IA no WhatsApp">
          <div class="chat-header">
            <span class="chat-avatar">
              <Icon name="bot" size={20} />
            </span>
            <div>
              <p class="chat-name">Studio Beleza</p>
              <p class="chat-online">IA online · responde na hora</p>
            </div>
            <span class="chat-ai-badge">IA</span>
          </div>

          <div class="chat-body">
            {CHAT_MSGS.map((m) => (
              <div class={`chat-msg ${m.from === "client" ? "is-client" : "is-bot"}`}>
                <p>{m.text}</p>
                <span class="chat-time">{m.time}</span>
              </div>
            ))}
            <div class="chat-typing" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </div>

          <div class="chat-footer">
            <Icon name="whatsapp" size={18} />
            <span>Mensagem</span>
            <Icon name="arrow" size={16} />
          </div>
        </div>
      </div>
    </Reveal>
  </div>

  <div class="container-tight relative z-10">
    <dl class="hero-stats">
      {STATS.map((s, i) => (
        <Reveal as="div" delay={360 + i * 80}>
          <div class="hero-stat">
            <dt class="hero-stat-value">{s.value}</dt>
            <dd class="hero-stat-label">{s.label}</dd>
            {s.caption && <dd class="hero-stat-caption">{s.caption}</dd>}
          </div>
        </Reveal>
      ))}
    </dl>
  </div>
</section>

<style>
  #hero {
    position: relative;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 30% 20%, rgb(var(--cor-primaria-rgb) / 0.06), transparent 70%),
      radial-gradient(40% 40% at 80% 0%, rgb(var(--cor-primaria-rgb) / 0.04), transparent 70%);
  }
  .hero-mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }
  html[data-theme="light"] .hero-mesh {
    opacity: 0.4;
  }
  .hero-title {
    font-size: clamp(2.2rem, 4.4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--cor-texto-primario);
  }
  @media (max-width: 640px) {
    .hero-br { display: none; }
  }
  .hero-hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    z-index: 1;
  }
  .hero-hl::before {
    content: "";
    position: absolute;
    inset: 0.05em -0.08em 0.1em -0.08em;
    background: var(--cor-primaria);
    border-radius: 4px;
    transform: skewX(-6deg);
    z-index: -1;
  }
  .hero-lede {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--cor-texto-secundario);
    max-width: 34ch;
  }
  .hero-microcopy {
    font-size: 0.85rem;
    color: var(--cor-subtitulos);
  }
  .hero-stats {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--cor-borda-geral);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 2rem;
  }
  @media (min-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .hero-stat {
      padding-inline: 1.75rem;
      border-left: 1px solid var(--cor-borda-geral);
    }
    .hero-stat:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  .hero-stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cor-texto-primario);
  }
  .hero-stat-label {
    margin-top: 0.125rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--cor-texto-secundario);
  }
  .hero-stat-caption {
    font-size: 0.72rem;
    color: var(--cor-subtitulos);
  }

  .hero-mockup-wrap { perspective: 1400px; }
  .hero-mockup {
    margin-inline: auto;
    max-width: 460px;
    transform: rotateY(-6deg) rotateX(2deg) translateZ(0);
    transform-style: preserve-3d;
    border-radius: var(--radius-lg);
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    box-shadow:
      0 50px 100px -30px rgba(0, 0, 0, 0.5),
      0 20px 40px -20px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  @media (max-width: 1024px) {
    .hero-mockup { transform: none; }
  }
  .chat-mockup { display: flex; flex-direction: column; }
  .chat-header {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    background: var(--cor-fundo-elevado);
    border-bottom: 1px solid var(--cor-borda-geral);
  }
  .chat-avatar {
    width: 40px; height: 40px; border-radius: var(--radius-full);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cor-whatsapp-bg);
    color: var(--cor-whatsapp);
    border: 1px solid rgb(37, 211, 102, 0.3);
    flex-shrink: 0;
  }
  .chat-name { font-size: 0.95rem; font-weight: 700; color: var(--cor-texto-primario); }
  .chat-online { font-size: 0.72rem; color: var(--cor-status-ok); font-weight: 600; margin-top: 1px; }
  .chat-ai-badge {
    margin-left: auto;
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--cor-texto-secundario);
    background: var(--cor-cards-hover);
    border: 1px solid var(--cor-borda-geral);
    padding: 3px 8px; border-radius: 9999px;
  }
  .chat-body {
    display: flex; flex-direction: column; gap: 10px;
    padding: 18px 16px 16px;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(var(--cor-primaria-rgb) / 0.04), transparent 60%),
      var(--cor-fundo-elevado);
    flex: 1;
  }
  .chat-msg {
    max-width: 82%;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    position: relative;
    box-shadow: var(--sombra-card);
  }
  .chat-msg p { font-size: 0.82rem; line-height: 1.45; margin: 0; color: var(--cor-texto-primario); }
  .chat-msg.is-bot {
    align-self: flex-start;
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    border-bottom-left-radius: 4px;
  }
  .chat-msg.is-client {
    align-self: flex-end;
    background: var(--cor-whatsapp-bg);
    border: 1px solid rgb(37, 211, 102, 0.28);
    border-bottom-right-radius: 4px;
  }
  .chat-time {
    display: block;
    text-align: right;
    font-size: 0.62rem;
    color: var(--cor-subtitulos);
    margin-top: 3px;
  }
  .chat-typing {
    align-self: flex-start;
    display: inline-flex; gap: 4px;
    padding: 9px 14px;
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    border-radius: var(--radius-md);
    border-bottom-left-radius: 4px;
  }
  .chat-typing span {
    width: 6px; height: 6px; border-radius: 9999px;
    background: var(--cor-subtitulos);
    animation: typing 1.2s ease-in-out infinite;
  }
  .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-typing span { animation: none; opacity: 1; }
  }
  .chat-footer {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px;
    background: var(--cor-fundo-elevado);
    border-top: 1px solid var(--cor-borda-geral);
    color: var(--cor-subtitulos);
    font-size: 0.82rem;
  }
  .chat-footer span { flex: 1; }
  .chat-footer :global(svg) { color: var(--cor-whatsapp); }
</style>

<script>
  const init = () => {
    const canvas = document.querySelector<HTMLCanvasElement>(".hero-mesh");
    if (!canvas) return;

    const hero = document.getElementById("hero");
    if (!hero) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const COLS = 22;
    const ROWS = 14;
    const SPACING = 64;
    const FOV = 340;
    const FLOW = 0.9;

    const primary = getComputedStyle(document.documentElement)
      .getPropertyValue("--cor-primaria")
      .trim() || "#FF5A24";

    let W = 0;
    let H = 0;
    let dots: { x: number; y: number; z: number }[] = [];
    let zOffset = 0;

    const size = () => {
      const rect = hero.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = W * DPR;
      canvas.height = H * DPR;
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    };

    const build = () => {
      dots = [];
      const w2 = (COLS - 1) * SPACING / 2;
      const h2 = (ROWS - 1) * SPACING / 2;
      for (let c = 0; c < COLS; c++) {
        for (let r = 0; r < ROWS; r++) {
          dots.push({
            x: c * SPACING - w2,
            y: r * SPACING - h2 + Math.sin(c * 0.6) * 6,
            z: (Math.random() - 0.5) * 90,
          });
        }
      }
    };

    const draw = (t: number) => {
      const alpha = Math.min(1, window.scrollY / hero.offsetHeight * 2);
      ctx.clearRect(0, 0, W, H);

      const cx = W / 2;
      const cy = H * 0.42;
      const rot = reduced ? 0 : Math.sin(t / 6000) * 0.22;

      const cosR = Math.cos(rot);
      const sinR = Math.sin(rot);

      zOffset += FLOW;
      if (zOffset > SPACING) zOffset -= SPACING;

      ctx.globalAlpha = (1 - alpha) * 0.8;

      for (const d of dots) {
        const relZ = ((d.z + zOffset) % SPACING + SPACING) % SPACING;
        const depth = relZ / SPACING;
        const scale = FOV / (FOV + (relZ - SPACING / 2));

        const xr = d.x * cosR;
        const yr = d.y;
        const sx = cx + xr * scale;
        const sy = cy + (yr * cosR + (relZ - SPACING / 2) * sinR * 0.35) * scale;

        const size = (1.1 + depth * 1.9) * scale;
        ctx.fillStyle = primary;
        ctx.globalAlpha = (1 - alpha) * (0.12 + depth * 0.55);
        ctx.beginPath();
        ctx.arc(sx, sy, size, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
    };

    let raf = 0;
    const loop = (t: number) => {
      draw(t);
      if (!reduced) raf = requestAnimationFrame(loop);
    };

    const start = () => {
      size();
      build();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    };

    const onScroll = () => {
      if (reduced) return;
      draw(performance.now());
    };

    start();
    window.addEventListener("resize", start);
    window.addEventListener("scroll", onScroll, { passive: true });
  };
  init();
  document.addEventListener("astro:after-swap", init);
</script>
