---
import Icon from "@components/Icon.astro";
import Reveal from "@components/Reveal.astro";
import { SITE } from "@config/site";
import { STATS, CHAT_MSGS } from "@data/content";

const app = `${SITE.appUrl}/criar-conta`;
const wpp = SITE.whatsapp;
---
<section id="hero" class="relative overflow-hidden pt-28 md:pt-36 pb-24 md:pb-32">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container-tight grid gap-10 md:gap-12 lg:grid-cols-[1.05fr_0.95fr] items-center">
    <div class="hero-copy">
      <Reveal>
        <span class="eyebrow">Agenda digital + IA no WhatsApp</span>
      </Reveal>
      <Reveal delay="80">
        <h1 class="hero-title mt-4">
          Enquanto você corta,<br />
          o <span class="hero-hl">WhatsApp agenda</span> por você.
        </h1>
      </Reveal>
      <Reveal delay="160">
        <p class="hero-lede mt-5">
          Cliente manda mensagem, a IA confere a agenda e marca na hora.
          O WhatsApp lembra na véspera. A fila espera no celular. Você só atende.
        </p>
      </Reveal>
      <Reveal delay="240">
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={app}
            class="btn btn-primary text-base"
            data-cta="hero-primary"
          >
            Começar grátis
            <Icon name="arrow-right" size={18} />
          </a>
          <a
            href={wpp}
            class="btn btn-ghost"
            target="_blank"
            rel="noopener"
            data-cta="hero-whatsapp"
          >
            <Icon name="whatsapp" size={18} />
            Falar no WhatsApp
          </a>
        </div>
      </Reveal>
      <Reveal delay="320">
        <p class="hero-microcopy mt-4">
          14 dias grátis · não pede cartão · a IA atende já no teste
        </p>
      </Reveal>

      <dl class="hero-stats mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {STATS.map((s, i) => (
          <Reveal as="div" delay={360 + i * 80}>
            <dt class="hero-stat-value">{s.value}</dt>
            <dd class="hero-stat-label">{s.label}</dd>
            {s.caption && <dd class="hero-stat-caption">{s.caption}</dd>}
          </Reveal>
        ))}
      </dl>
    </div>

    <Reveal as="div" delay="200" class="hero-mockup-wrap">
      <div class="hero-mockup chat-mockup" aria-label="Exemplo de conversa com a IA no WhatsApp">
        <div class="chat-header">
          <span class="chat-avatar">
            <Icon name="bot" size={20} />
          </span>
          <div>
            <p class="chat-name">Barbearia do João</p>
            <p class="chat-online">IA online · responde na hora</p>
          </div>
          <span class="chat-ai-badge">IA</span>
        </div>

        <div class="chat-body">
          {CHAT_MSGS.map((m) => (
            <div class={`chat-msg ${m.from === "client" ? "is-client" : "is-bot"}`}>
              <p>{m.text}</p>
              <span class="chat-time">{m.time}</span>
            </div>
          ))}
          <div class="chat-typing" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>

        <div class="chat-footer">
          <Icon name="whatsapp" size={18} />
          <span>Mensagem</span>
          <Icon name="arrow" size={16} />
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  #hero {
    position: relative;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 30% 20%, rgb(var(--cor-primaria-rgb) / 0.06), transparent 70%),
      radial-gradient(40% 40% at 80% 0%, rgb(var(--cor-primaria-rgb) / 0.04), transparent 70%);
  }
  .hero-title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.0;
    color: var(--cor-texto-primario);
  }
  .hero-hl {
    position: relative;
    display: inline-block;
    z-index: 1;
  }
  .hero-hl::before {
    content: "";
    position: absolute;
    inset: 0.05em -0.08em 0.1em -0.08em;
    background: var(--cor-primaria);
    border-radius: 4px;
    transform: skewX(-6deg);
    z-index: -1;
  }
  .hero-lede {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--cor-texto-secundario);
    max-width: 32ch;
  }
  .hero-microcopy {
    font-size: 0.85rem;
    color: var(--cor-subtitulos);
  }
  .hero-stats { gap: 1.25rem 0.75rem; }
  .hero-stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cor-texto-primario);
  }
  .hero-stat-label {
    margin-top: 0.125rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--cor-texto-secundario);
  }
  .hero-stat-caption {
    font-size: 0.72rem;
    color: var(--cor-subtitulos);
  }

  .hero-mockup-wrap { perspective: 1400px; }
  .hero-mockup {
    margin-inline: auto;
    max-width: 460px;
    transform: rotateY(-6deg) rotateX(2deg) translateZ(0);
    transform-style: preserve-3d;
    border-radius: var(--radius-lg);
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    box-shadow:
      0 50px 100px -30px rgba(0, 0, 0, 0.5),
      0 20px 40px -20px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  @media (max-width: 1024px) {
    .hero-mockup { transform: none; }
  }
  .chat-mockup { display: flex; flex-direction: column; }
  .chat-header {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    background: var(--cor-fundo-elevado);
    border-bottom: 1px solid var(--cor-borda-geral);
  }
  .chat-avatar {
    width: 40px; height: 40px; border-radius: var(--radius-full);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cor-whatsapp-bg);
    color: var(--cor-whatsapp);
    border: 1px solid rgb(37, 211, 102, 0.3);
    flex-shrink: 0;
  }
  .chat-name { font-size: 0.95rem; font-weight: 700; color: var(--cor-texto-primario); }
  .chat-online { font-size: 0.72rem; color: var(--cor-status-ok); font-weight: 600; margin-top: 1px; }
  .chat-ai-badge {
    margin-left: auto;
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--cor-texto-secundario);
    background: var(--cor-cards-hover);
    border: 1px solid var(--cor-borda-geral);
    padding: 3px 8px; border-radius: 9999px;
  }
  .chat-body {
    display: flex; flex-direction: column; gap: 10px;
    padding: 18px 16px 16px;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(var(--cor-primaria-rgb) / 0.04), transparent 60%),
      var(--cor-fundo-elevado);
    flex: 1;
  }
  .chat-msg {
    max-width: 82%;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    position: relative;
    box-shadow: var(--sombra-card);
  }
  .chat-msg p { font-size: 0.82rem; line-height: 1.45; margin: 0; color: var(--cor-texto-primario); }
  .chat-msg.is-bot {
    align-self: flex-start;
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    border-bottom-left-radius: 4px;
  }
  .chat-msg.is-client {
    align-self: flex-end;
    background: var(--cor-whatsapp-bg);
    border: 1px solid rgb(37, 211, 102, 0.28);
    border-bottom-right-radius: 4px;
  }
  .chat-time {
    display: block;
    text-align: right;
    font-size: 0.62rem;
    color: var(--cor-subtitulos);
    margin-top: 3px;
  }
  .chat-typing {
    align-self: flex-start;
    display: inline-flex; gap: 4px;
    padding: 9px 14px;
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    border-radius: var(--radius-md);
    border-bottom-left-radius: 4px;
  }
  .chat-typing span {
    width: 6px; height: 6px; border-radius: 9999px;
    background: var(--cor-subtitulos);
    animation: typing 1.2s ease-in-out infinite;
  }
  .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-typing span { animation: none; opacity: 1; }
  }
  .chat-footer {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px;
    background: var(--cor-fundo-elevado);
    border-top: 1px solid var(--cor-borda-geral);
    color: var(--cor-subtitulos);
    font-size: 0.82rem;
  }
  .chat-footer span { flex: 1; }
  .chat-footer :global(svg) { color: var(--cor-whatsapp); }
</style>
