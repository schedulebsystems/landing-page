---
import Icon from "@components/Icon.astro";
import Reveal from "@components/Reveal.astro";
import ChatMockup from "@components/ChatMockup.astro";
import { AI_CHAT_MSGS } from "@data/content";
import { SITE } from "@config/site";

const app = `${SITE.appUrl}/criar-conta`;
---

<section id="ia-whatsapp" class="py-16 md:py-24 ai-section">
  <div class="container-tight">
    <div class="ai-band">
      <div class="ai-glow" aria-hidden="true"></div>

      <div class="ai-copy">
        <Reveal>
          <span class="ai-chip">
            <Icon name="sparkles" size={14} />
            Agente de IA
          </span>
        </Reveal>
        <Reveal delay="80">
          <h2 class="ai-title">
            Uma IA que atende o seu negócio<br class="hidden md:block" />
            <span class="ai-hl">mesmo quando você tá de folga.</span>
          </h2>
        </Reveal>
        <Reveal delay="160">
          <p class="ai-lede">
            É a Skedoole no WhatsApp do seu negócio: entende o que o cliente
            quer, confere a agenda de verdade e fecha o agendamento — sem
            fila de espera, sem "vou ver e te aviso".
          </p>
        </Reveal>
        <Reveal delay="240">
          <ul class="ai-bullets">
            <li>
              <Icon name="check" size={16} />
              <span><b>Agenda sozinha</b> — consulta serviços, profissionais e horários disponíveis e marca.</span>
            </li>
            <li>
              <Icon name="check" size={16} />
              <span><b>Remarca e cancela</b> por conversa, respeitando seus bloqueios e regras.</span>
            </li>
            <li>
              <Icon name="check" size={16} />
              <span><b>Atende 24/7</b> — madrugada, domingo, feriado. Quem não dorme é ela, não você.</span>
            </li>
            <li>
              <Icon name="check" size={16} />
              <span><b>Passa o bastão na hora</b> — assunto especial chama alguém da sua equipe no app.</span>
            </li>
          </ul>
        </Reveal>
        <Reveal delay="320">
          <a href={app} class="btn btn-primary mt-7 text-sm" data-cta="ai-cta">
            Ativar a IA no meu negócio <Icon name="arrow-right" size={16} />
          </a>
        </Reveal>
      </div>

      <Reveal as="div" delay="200" class="ai-chat-wrap">
        <ChatMockup messages={AI_CHAT_MSGS} class="ai-chat" />
        <p class="ai-caption">De madrugada, sem depender de ninguém: a IA remarca e libera o horário antigo em 2 minutos.</p>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .ai-section {
    position: relative;
    overflow: hidden;
  }
  .ai-band {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 3.5rem);
    background:
      linear-gradient(180deg, rgb(var(--cor-primaria-rgb) / 0.08), transparent 60%),
      var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    overflow: hidden;
  }
  @media (min-width: 980px) {
    .ai-band { grid-template-columns: 1.1fr 0.9fr; }
  }
  .ai-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 60% at 10% 10%, rgb(var(--cor-primaria-rgb) / 0.12), transparent 60%),
      radial-gradient(40% 50% at 90% 90%, rgb(var(--cor-primaria-rgb) / 0.08), transparent 60%);
  }
  .ai-copy, .ai-chat-wrap { position: relative; z-index: 1; }
  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cor-primaria);
    background: var(--cor-primaria-soft);
    border: 1px solid rgb(var(--cor-primaria-rgb) / 0.3);
    padding: 6px 12px;
    border-radius: 9999px;
  }
  .ai-title {
    margin-top: 16px;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--cor-texto-primario);
  }
  .ai-hl {
    color: var(--cor-primaria);
  }
  .ai-lede {
    margin-top: 16px;
    font-size: 1.02rem;
    color: var(--cor-texto-secundario);
    max-width: 52ch;
    line-height: 1.6;
  }
  .ai-bullets {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ai-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.94rem;
    color: var(--cor-texto-secundario);
    line-height: 1.5;
  }
  .ai-bullets :global(svg) {
    color: var(--cor-primaria);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .ai-bullets b { color: var(--cor-texto-primario); font-weight: 600; }
  .ai-chat-wrap { max-width: 440px; margin-inline: auto; width: 100%; }
  .ai-chat {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--cor-fundo-elevado);
    border: 1px solid var(--cor-borda-geral);
    box-shadow: var(--sombra-card-hover);
  }
  .ai-chat :global(.chat-avatar) {
    background: var(--cor-primaria-soft);
    color: var(--cor-primaria);
    border: 1px solid rgb(var(--cor-primaria-rgb) / 0.3);
  }
  .ai-chat :global(.chat-online) {
    color: var(--cor-primaria);
  }
  .ai-chat :global(.chat-msg.is-client) {
    background: var(--cor-primaria-soft);
    border: 1px solid rgb(var(--cor-primaria-rgb) / 0.28);
  }
  .ai-chat :global(.chat-footer svg) {
    color: var(--cor-primaria);
  }
  .ai-caption {
    margin-top: 12px;
    text-align: center;
    font-size: 0.78rem;
    color: var(--cor-subtitulos);
  }
</style>
