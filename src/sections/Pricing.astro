---
import Icon from "@components/Icon.astro";
import Reveal from "@components/Reveal.astro";
import { PLANS } from "@data/content";
import { SITE } from "@config/site";

const app = `${SITE.appUrl}/criar-conta`;
const wpp = SITE.whatsapp;

const fmtBRL = (n: number) =>
  n === 0
    ? "R$ 0"
    : new Intl.NumberFormat("pt-BR", {
        style: "currency",
        currency: "BRL",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(n);

const fmtInt = (n: number) =>
  new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0,
  }).format(n);

const savingOf = (p: (typeof PLANS)[number]) =>
  p.monthly !== null && p.annual !== null ? (p.monthly - p.annual) * 12 : 0;
---
<section id="precos" class="py-24 md:py-32">
  <div class="container-tight">
    <Reveal class="text-center mx-auto max-w-2xl">
      <span class="eyebrow justify-center">Investimento</span>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold tracking-tight">
        Preço direto. Sem pegadinha, sem surpresa.
      </h2>
      <p class="mt-4 text-[var(--cor-texto-secundario)]">
        Teste grátis por 14 dias. Sem cartão. Cancele em 1 toque.
      </p>
    </Reveal>

    <div class="prices-included mt-8">
      <span class="prices-included-label">Incluso em todos os planos</span>
      <div class="prices-included-items">
        {[
          "IA no WhatsApp",
          "Lembrete e confirmação automáticos",
          "Agenda online 24h",
          "Fila digital",
          "Comissão automática",
          "Relatórios",
        ].map((i) => (
          <span class="prices-included-item">
            <Icon name="check" size={14} />
            {i}
          </span>
        ))}
      </div>
    </div>

    <div class="prices-toggle-wrap mt-8">
      <div class="prices-toggle" role="radiogroup" aria-label="Ciclo de cobrança">
        <span class="prices-toggle-thumb" aria-hidden="true"></span>
        <button type="button" data-cycle="monthly" class="is-active" role="radio" aria-checked="true">Mensal</button>
        <button type="button" data-cycle="annual" role="radio" aria-checked="false">
          Anual <span class="save">-8%</span>
        </button>
      </div>
    </div>
  </div>

  <Reveal class="prices-scroll">
    <button type="button" class="prices-arrow prices-arrow-prev" aria-label="Ver planos anteriores">
      <Icon name="chevron-left" size={20} />
    </button>
    <div class="prices-grid">
      {PLANS.map((p) => (
        <article class={`plan ${p.featured ? "plan-featured" : ""}`}>
          {p.badge && <div class="plan-badge">{p.badge}</div>}
          <span class="plan-cap">{p.cap}</span>
          <h3 class="plan-name">{p.name}</h3>
          <p class="plan-tagline">{p.tagline}</p>
          <div class="plan-price">
            {p.custom ? (
              <span class="plan-custom-price">Sob consulta</span>
            ) : (
              <>
                <span data-monthly>{fmtBRL(p.monthly!)}</span>
                <span data-annual hidden>{fmtBRL(p.annual!)}</span>
              </>
            )}
            <span class="plan-cycle">{p.custom ? "" : "/mês"}</span>
          </div>
          {!p.custom && (
            <p class="plan-saving" data-saving hidden>
              economize {fmtInt(savingOf(p))}/ano
            </p>
          )}
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <Icon name="check" size={16} />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={p.custom ? wpp : app}
            class={`btn plan-cta btn-primary ${p.featured ? "plan-cta-featured" : ""}`}
            target={p.custom ? "_blank" : undefined}
            rel={p.custom ? "noopener" : undefined}
            data-cta={`plan-${p.name.toLowerCase()}`}
          >
            {p.cta}
          </a>
        </article>
      ))}
    </div>
    <button type="button" class="prices-arrow prices-arrow-next" aria-label="Ver mais planos">
      <Icon name="chevron-right" size={20} />
    </button>
  </Reveal>

  <div class="container-tight">
    <p class="prices-foot mt-10 text-center text-sm text-[var(--cor-subtitulos)]">
      Precificação em BRL. Sem taxa de adesão. Cancele quando quiser.
    </p>
    <p class="prices-note mt-3 text-center text-sm text-[var(--cor-subtitulos)]">
      O plano conta o total de profissionais, somando todas as suas unidades.
      Precisa de mais de 20? Fale com a gente — fechamos um plano sob medida.
    </p>
  </div>
</section>

<style>
  .prices-toggle-wrap { display: flex; justify-content: center; }
  .prices-included {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    background: var(--cor-fundo-elevado);
    border: 1px dashed var(--cor-borda-hover);
    border-radius: var(--radius-lg);
  }
  .prices-included-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cor-subtitulos);
  }
  .prices-included-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .prices-included-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cor-texto-secundario);
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    padding: 6px 12px;
    border-radius: 9999px;
  }
  .prices-included-item :global(svg) { color: var(--cor-status-ok); flex-shrink: 0; }
  .prices-toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    background: var(--cor-fundo-elevado);
    border: 1px solid var(--cor-borda-geral);
    padding: 4px;
    border-radius: 9999px;
    gap: 2px;
  }
  .prices-toggle-thumb {
    position: absolute;
    top: 4px; bottom: 4px; left: 0;
    width: 0;
    background: var(--cor-primaria);
    border-radius: 9999px;
    box-shadow: 0 4px 14px -4px rgb(var(--cor-primaria-rgb) / 0.55);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), width 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }
  .prices-toggle button {
    position: relative;
    z-index: 1;
    border: 0; cursor: pointer;
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 0.85rem; font-weight: 600;
    background: transparent;
    color: var(--cor-texto-secundario);
    transition: color 0.2s ease;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  }
  .prices-toggle button.is-active {
    color: #fff;
  }
  .prices-toggle .save {
    font-size: 0.7rem; font-weight: 700;
    background: var(--cor-primaria);
    color: #fff;
    padding: 2px 6px; border-radius: 9999px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .prices-toggle button.is-active .save {
    background: #fff;
    color: var(--cor-primaria);
  }
  .prices-scroll {
    position: relative;
    margin-top: 2.5rem;
  }
  .prices-scroll::before,
  .prices-scroll::after {
    content: "";
    position: absolute;
    top: 0; bottom: 0;
    width: clamp(2rem, 6vw, 4.5rem);
    pointer-events: none;
    z-index: 1;
  }
  .prices-scroll::before {
    left: 0;
    background: linear-gradient(to right, var(--cor-fundo), transparent);
  }
  .prices-scroll::after {
    right: 0;
    background: linear-gradient(to left, var(--cor-fundo), transparent);
  }
  .prices-grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(1rem, calc((100vw - 1200px) / 2 + 2rem));
    padding-block: 10px 14px;
  }
  .prices-grid::-webkit-scrollbar { display: none; }
  .prices-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px; height: 44px;
    border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cor-cards);
    color: var(--cor-texto-primario);
    border: 1px solid var(--cor-borda-hover);
    box-shadow: var(--sombra-card-hover);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .prices-arrow:hover {
    background: var(--cor-cards-hover);
    border-color: var(--cor-texto-secundario);
  }
  .prices-arrow-prev { left: 14px; }
  .prices-arrow-next { right: 14px; }
  @media (max-width: 719px) {
    .prices-arrow { display: none; }
  }
  .plan {
    position: relative;
    flex: 0 0 auto;
    width: clamp(280px, 26vw, 340px);
    scroll-snap-align: center;
    padding: 24px;
    background: var(--cor-cards);
    border: 1px solid var(--cor-borda-geral);
    border-radius: var(--radius-lg);
    box-shadow: var(--sombra-card);
    display: flex; flex-direction: column;
  }
  .plan-featured {
    border-color: var(--cor-primaria);
    box-shadow:
      0 0 0 1px var(--cor-primaria),
      0 30px 60px -30px rgb(var(--cor-primaria-rgb) / 0.3);
  }
  .plan-badge {
    position: absolute;
    top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--cor-primaria);
    color: #fff;
    font-size: 0.7rem; font-weight: 700;
    padding: 4px 10px; border-radius: 9999px;
    letter-spacing: 0.04em; text-transform: uppercase;
    box-shadow: 0 6px 14px -6px rgb(var(--cor-primaria-rgb) / 0.6);
  }
  .plan-cap {
    align-self: flex-start;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--cor-texto-secundario);
    background: var(--cor-fundo-elevado);
    border: 1px solid var(--cor-borda-geral);
    padding: 4px 10px; border-radius: 9999px;
  }
  .plan-name { font-size: 1.35rem; font-weight: 800; color: var(--cor-texto-primario); margin-top: 14px; letter-spacing: -0.02em; }
  .plan-tagline { font-size: 0.85rem; color: var(--cor-subtitulos); margin-top: 2px; }
  .plan-price { margin-top: 16px; display: flex; align-items: baseline; gap: 4px; }
  .plan-price :strong, .plan-price span:not(.plan-cycle) {
    font-size: clamp(2.1rem, 2vw + 1rem, 2.6rem);
    font-weight: 800; letter-spacing: -0.03em;
    color: var(--cor-texto-primario);
    line-height: 1;
  }
  .plan-featured .plan-price :strong,
  .plan-featured .plan-price span:not(.plan-cycle):not(.plan-custom-price) {
    color: var(--cor-primaria);
  }
  .plan-cycle { font-size: 0.85rem; color: var(--cor-subtitulos); margin-left: 4px; }
  .plan-price .plan-custom-price {
    font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em;
    color: var(--cor-texto-primario);
  }
  .plan-saving {
    margin-top: 4px;
    font-size: 0.74rem; font-weight: 600;
    color: var(--cor-status-ok);
    min-height: 1.2em;
  }
  .prices-note { max-width: 560px; margin-left: auto; margin-right: auto; line-height: 1.5; }
  .plan-features {
    list-style: none; padding: 0; margin: 20px 0 0;
    display: flex; flex-direction: column; gap: 10px;
    flex: 1;
  }
  .plan-features li {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 0.88rem; color: var(--cor-texto-secundario);
  }
  .plan-features :global(svg) { color: var(--cor-status-ok); flex-shrink: 0; margin-top: 2px; }
  .plan-cta { margin-top: 22px; width: 100%; }
  .plan-cta-featured {
    box-shadow: 0 10px 30px -8px rgb(var(--cor-primaria-rgb) / 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  const setup = () => {
    const toggle = document.querySelector<HTMLElement>(".prices-toggle");
    const buttons = document.querySelectorAll<HTMLButtonElement>(".prices-toggle button");
    const thumb = document.querySelector<HTMLElement>(".prices-toggle-thumb");
    if (buttons.length === 0) return;

    const moveThumb = (btn: HTMLButtonElement) => {
      if (!toggle || !thumb) return;
      const tRect = toggle.getBoundingClientRect();
      const bRect = btn.getBoundingClientRect();
      thumb.style.width = `${bRect.width}px`;
      thumb.style.transform = `translateX(${bRect.left - tRect.left}px)`;
    };

    const apply = (cycle: string) => {
      buttons.forEach((b) => {
        const active = b.dataset.cycle === cycle;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-checked", String(active));
        if (active) moveThumb(b);
      });
      document.querySelectorAll<HTMLElement>(".prices-grid .plan").forEach((plan) => {
        const m = plan.querySelector<HTMLElement>("[data-monthly]");
        const a = plan.querySelector<HTMLElement>("[data-annual]");
        const s = plan.querySelector<HTMLElement>("[data-saving]");
        if (m) m.hidden = cycle !== "monthly";
        if (a) a.hidden = cycle !== "annual";
        if (s) s.hidden = cycle !== "annual";
      });
    };

    const activeBtn = toggle?.querySelector<HTMLButtonElement>("button.is-active");
    if (activeBtn) moveThumb(activeBtn);

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        apply(btn.dataset.cycle || "monthly");
      });
    });

    const grid = document.querySelector<HTMLElement>(".prices-grid");
    const prev = document.querySelector<HTMLButtonElement>(".prices-arrow-prev");
    const next = document.querySelector<HTMLButtonElement>(".prices-arrow-next");
    const step = () => {
      if (!grid) return 0;
      const card = grid.querySelector<HTMLElement>(".plan");
      return (card ? card.offsetWidth : grid.clientWidth) + 16;
    };
    prev?.addEventListener("click", () => grid?.scrollBy({ left: -step(), behavior: "smooth" }));
    next?.addEventListener("click", () => grid?.scrollBy({ left: step(), behavior: "smooth" }));

    window.addEventListener("resize", () => {
      const active = toggle?.querySelector<HTMLButtonElement>("button.is-active");
      if (active) moveThumb(active);
    });
  };
  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
